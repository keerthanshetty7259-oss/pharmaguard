# ---------- PharmaGuard backend configuration ----------
# Copy this file to ".env" (npm run setup does it for you) and edit the values.

PORT=5000

# PostgreSQL connection. Change USER, PASSWORD, and the database name if needed.
# The database is created automatically by "npm run setup" if it does not exist.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmaguard

# Secret used to sign login tokens (JWT). "npm run setup" generates a random one.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# OpenAI API key for the AI chatbot (Dashboard 5). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RxNorm REST API (free, no key needed)
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
